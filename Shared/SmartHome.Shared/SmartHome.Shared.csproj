<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.8" />
    <PackageReference Include="MQTTnet" Version="5.0.1.1416" />
    <PackageReference Include="MQTTnet.AspNetCore" Version="5.0.1.1416" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so DatabaseInitializer can load it regardless of the process's working directory
         (dotnet run from Api/SmartHome.Api, a container, or anywhere else). -->
    <EmbeddedResource Include="DatabaseScripts\create.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets unit tests construct MqttHelper with a mocked IMqttClient (internal constructor) to
         exercise broker-failure paths (e.g. UnsubscribeAsync throwing) without a real broker. -->
    <InternalsVisibleTo Include="SmartHome.Shared.UnitTests" />
    <InternalsVisibleTo Include="SmartHome.Slices.Devices.UnitTests" />
  </ItemGroup>

</Project>
